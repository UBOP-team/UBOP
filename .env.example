# ==============================================================================
# UBOP (Unified Business Operations Platform) - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local or production environment.
# Example: cp .env.example .env

# --- Application Core ---
PROJECT_NAME="UBOP API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# --- Database & Storage ---
# Local development (Async SQLite):
DATABASE_URL="sqlite+aiosqlite:///./ubop.db"
# Docker / Production (PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ubop"

# --- Redis & EventBus ---
REDIS_URL="redis://localhost:6379/0"

# --- CORS & Security ---
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'
SECRET_KEY="supersecret_ubop_dev_key_change_in_production"

# --- STRIPE PAYMENT INTEGRATION ---
# Get API keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- SHOPIFY COMMERCE INTEGRATION ---
# Format: your-store.myshopify.com
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_API_ACCESS_TOKEN="shpat_..."
SHOPIFY_API_VERSION="2024-07"

# --- SLACK OPERATIONS ALERTS ---
# Webhook URL from: https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
SLACK_BOT_TOKEN="xoxb-..."
SLACK_DEFAULT_CHANNEL="#operations-alerts"

# --- TELEGRAM VIP ALERTING ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- SMTP TRANSACTIONAL EMAIL ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="notifications@ubop.internal"

# --- AI INSIGHTS & GATEWAY ---
OPENAI_API_KEY=""

# --- Web Frontend (Vite) ---
VITE_API_URL="http://127.0.0.1:8000"
VITE_APP_TITLE="UBOP — Unified Business Operations Platform"

# --- Docker Compose ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="ubop"
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
